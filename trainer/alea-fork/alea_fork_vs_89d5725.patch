+// Pawn-pair inputs (grafting rubicon-alea-v2): unordered pairs of pawns on the
+// same or adjacent files. 96 pawn slots (48 own + 48 enemy, ranks 2-7 oriented
+// per perspective, file-mirrored with the king exactly like HalfKA/threats via
+// OrientTBL) -> index hi*(hi-1)/2 + lo, 96*95/2 = 4560 features. Spec identical
+// to Stormphrax (threats.cpp ppFeatureIndex / kPpMasks file-band, the 7->8 Elo
+// jump), also adopted by Viridithas and Pawnocchio. Captures phalanx/chains/
+// doubled/isolated pawns as LEARNED patterns - pawn-pawn geometry that threat
+// features cannot see (side-by-side pawns attack nothing).
+struct PawnPair {
+    static constexpr std::string_view NAME = "PawnPair";
+
+    static constexpr int INPUTS              = 4560;
+    static constexpr int MAX_ACTIVE_FEATURES = 120;  // C(16,2): all pawns in one file band
+
+    static int pawn_id(Color persp, Square ksq, Color pc, Square sq) {
+        // Same orientation as FullThreats/HalfKA: rank-flip for black perspective,
+        // file-flip when the perspective king sits on files e-h.
+        int o = int(sq) ^ int(FullThreats::OrientTBL[(int) persp][(int) ksq]);
+        return (pc != persp ? 48 : 0) + o - 8;  // oriented pawns live on 8..55 -> 0..47
+    }
+
+    static std::pair<int, int>
+    fill_features_sparse(const TrainingDataEntry& e, int* features, float* values, Color color) {
+        auto&  pos = e.pos;
+        Square ksq = pos.kingSquare(color);
+
+        Square sqs[16];
+        Color  cols[16];
+        int    n = 0;
+        for (Square s : pos.piecesBB(whitePawn))
+        {
+            sqs[n]  = s;
+            cols[n] = Color::White;
+            n++;
+        }
+        for (Square s : pos.piecesBB(blackPawn))
+        {
+            sqs[n]  = s;
+            cols[n] = Color::Black;
+            n++;
+        }
+
+        int k = 0;
+        for (int i = 0; i < n; i++)
+        {
+            for (int j = i + 1; j < n; j++)
+            {
+                // File band: pair is active only if the pawns are on the same or
+                // adjacent files (Stormphrax kPpMasks). File distance is invariant
+                // under the orientation flips, so check on raw squares.
+                int df = (int(sqs[i]) & 7) - (int(sqs[j]) & 7);
+                if (df < -1 || df > 1)
+                    continue;
+                int a  = pawn_id(color, ksq, cols[i], sqs[i]);
+                int b  = pawn_id(color, ksq, cols[j], sqs[j]);
+                int hi = a > b ? a : b;
+                int lo = a > b ? b : a;
+
+                features[k] = hi * (hi - 1) / 2 + lo;
+                values[k]   = 1.0f;
+                k++;
+            }
+        }
+        return {k, INPUTS};
+    }
+};
+
+struct PawnPairExtractor: IFeatureExtractor {
+    int inputs() const override { return PawnPair::INPUTS; }
+    int max_active_features() const override { return PawnPair::MAX_ACTIVE_FEATURES; }
+    std::pair<int, int> fill_features_sparse(const TrainingDataEntry& e,
+                                             int*                     features,
+                                             float*                   values,
+                                             Color                    color) const override {
+        return PawnPair::fill_features_sparse(e, features, values, color);
+    }
+};
+
+// Passed-pawn inputs (grafting rubicon-alea-v3): one feature per passed pawn.
+// 96 slots (48 own + 48 enemy, ranks 2-7 oriented per perspective and
+// file-mirrored with the king like HalfKA/threats/PawnPair). "Passed" = no
+// enemy pawn on the same or adjacent files ahead AND no own pawn directly
+// ahead on the same file (a rear doubled pawn is not a passer). Deliberately
+// square-only (no blocked/king/connected flags): those interactions are
+// learnable through the SFNNv13 pairwise-multiplied L1 against the HalfKA
+// and PawnPair blocks. Must match the engine (nnue/features/passed_pawns.cpp)
+// and the pure-python reference (graft/verify_passedpawns.py).
+struct PassedPawns {
+    static constexpr std::string_view NAME = "PassedPawns";
+
+    static constexpr int INPUTS              = 96;
+    static constexpr int MAX_ACTIVE_FEATURES = 16;  // all pawns passed (theoretical bound)
+
+    // Same slot encoding as PawnPair's pawn_id: 0..47 own, 48..95 enemy.
+    static int pawn_id(Color persp, Square ksq, Color pc, Square sq) {
+        int o = int(sq) ^ int(FullThreats::OrientTBL[(int) persp][(int) ksq]);
+        return (pc != persp ? 48 : 0) + o - 8;  // oriented pawns live on 8..55 -> 0..47
+    }
+
+    // Passed check on RAW squares (orientation enters only at index time).
+    static bool is_passed(int s, bool white, const int* own, int nOwn, const int* opp, int nOpp) {
+        const int f = s & 7, r = s >> 3;
+        for (int i = 0; i < nOpp; i++)
+        {
+            const int of = opp[i] & 7, orr = opp[i] >> 3;
+            const int df = of - f;
+            if (df >= -1 && df <= 1 && (white ? orr > r : orr < r))
+                return false;
+        }
+        for (int i = 0; i < nOwn; i++)
+        {
+            if (own[i] == s)
+                continue;
+            const int orr = own[i] >> 3;
+            if ((own[i] & 7) == f && (white ? orr > r : orr < r))
+                return false;
+        }
+        return true;
+    }
+
+    // Conta i pedoni passati (entrambi i lati) di una posizione: riusata dal
+    // filtro dataloader min_passed_pawns (stessa verita' di fill_features_sparse,
+    // un solo posto dove "passato" e' definito).
+    static int count_passed(const TrainingDataEntry& e) {
+        auto& pos = e.pos;
+        int   wp[8], bp[8];
+        int   nw = 0, nb = 0;
+        for (Square s : pos.piecesBB(whitePawn))
+            wp[nw++] = int(s);
+        for (Square s : pos.piecesBB(blackPawn))
+            bp[nb++] = int(s);
+        int cnt = 0;
+        for (int i = 0; i < nw; i++)
+            if (is_passed(wp[i], true, wp, nw, bp, nb))
+                cnt++;
+        for (int i = 0; i < nb; i++)
+            if (is_passed(bp[i], false, bp, nb, wp, nw))
+                cnt++;
+        return cnt;
+    }
+
+    static std::pair<int, int>
+    fill_features_sparse(const TrainingDataEntry& e, int* features, float* values, Color color) {
+        auto&  pos = e.pos;
+        Square ksq = pos.kingSquare(color);
+
+        int wp[8], bp[8];
+        int nw = 0, nb = 0;
+        for (Square s : pos.piecesBB(whitePawn))
+            wp[nw++] = int(s);
+        for (Square s : pos.piecesBB(blackPawn))
+            bp[nb++] = int(s);
+
+        int k = 0;
+        for (int i = 0; i < nw; i++)
+            if (is_passed(wp[i], true, wp, nw, bp, nb))
+            {
+                features[k] = pawn_id(color, ksq, Color::White, Square(wp[i]));
+                values[k]   = 1.0f;
+                k++;
+            }
+        for (int i = 0; i < nb; i++)
+            if (is_passed(bp[i], false, bp, nb, wp, nw))
+            {
+                features[k] = pawn_id(color, ksq, Color::Black, Square(bp[i]));
+                values[k]   = 1.0f;
+                k++;
+            }
+        return {k, INPUTS};
+    }
+};
+
+// Candidate-passer inputs (grafting rubicon-alea, v4 slot): one feature per
+// candidate passed pawn. 96 slots (48 own + 48 enemy, oriented per
+// perspective and file-mirrored with the king like HalfKA/threats/PawnPair/
+// PassedPawns; same pawn_id math as PassedPawns). A pawn of color C on sq is
+// a candidate passer iff (1) NOT already passed (the PassedPawns block
+// covers those), (2) its file is semi-open ahead (no pawn of either color on
+// the same file strictly ahead: no doubled pawn in front, no enemy blocker),
+// and (3) majority count: own pawns on adjacent files behind-or-level >=
+// enemy pawns on adjacent files strictly ahead (helpers vs sentinels).
+// Given (2), "not passed" reduces to: at least one sentinel exists.
+// Deliberately square-only. Must match the engine
+// (nnue/features/candidate_passers.cpp) and the pure-python reference
+// (Training_NNUE/TrainingV5_CandidatePassers/graft/candidate_passers.py).
+struct CandidatePassers {
+    static constexpr std::string_view NAME = "CandidatePassers";
+
+    static constexpr int INPUTS              = 96;
+    static constexpr int MAX_ACTIVE_FEATURES = 16;  // every pawn a candidate (theoretical bound)
+
+    // Candidate check on RAW squares (orientation enters only at index time).
+    // white = the color of the pawn on s; own contains s itself.
+    static bool
+    is_candidate(int s, bool white, const int* own, int nOwn, const int* opp, int nOpp) {
+        const int f = s & 7, r = s >> 3;
+        // (2) semi-open file ahead: no pawn of either color on file f strictly ahead
+        for (int i = 0; i < nOwn; i++)
+        {
+            const int orr = own[i] >> 3;
+            if ((own[i] & 7) == f && (white ? orr > r : orr < r))
+                return false;
+        }
+        for (int i = 0; i < nOpp; i++)
+        {
+            const int orr = opp[i] >> 3;
+            if ((opp[i] & 7) == f && (white ? orr > r : orr < r))
+                return false;
+        }
+        // (1) not already passed: given (2), passed <=> zero sentinels
+        int sentinels = 0;
+        for (int i = 0; i < nOpp; i++)
+        {
+            const int of = opp[i] & 7, orr = opp[i] >> 3;
+            if ((of == f - 1 || of == f + 1) && (white ? orr > r : orr < r))
+                sentinels++;
+        }
+        if (sentinels == 0)
+            return false;
+        // (3) majority: helpers behind-or-equal >= sentinels ahead
+        int helpers = 0;
+        for (int i = 0; i < nOwn; i++)
+        {
+            const int of = own[i] & 7, orr = own[i] >> 3;
+            if ((of == f - 1 || of == f + 1) && !(white ? orr > r : orr < r))
+                helpers++;
+        }
+        return helpers >= sentinels;
+    }
+
+    static std::pair<int, int>
+    fill_features_sparse(const TrainingDataEntry& e, int* features, float* values, Color color) {
+        auto&  pos = e.pos;
+        Square ksq = pos.kingSquare(color);
+
+        int wp[8], bp[8];
+        int nw = 0, nb = 0;
+        for (Square s : pos.piecesBB(whitePawn))
+            wp[nw++] = int(s);
+        for (Square s : pos.piecesBB(blackPawn))
+            bp[nb++] = int(s);
+
+        int k = 0;
+        for (int i = 0; i < nw; i++)
+            if (is_candidate(wp[i], true, wp, nw, bp, nb))
+            {
+                features[k] = PassedPawns::pawn_id(color, ksq, Color::White, Square(wp[i]));
+                values[k]   = 1.0f;
+                k++;
+            }
+        for (int i = 0; i < nb; i++)
+            if (is_candidate(bp[i], false, bp, nb, wp, nw))
+            {
+                features[k] = PassedPawns::pawn_id(color, ksq, Color::Black, Square(bp[i]));
+                values[k]   = 1.0f;
+                k++;
+            }
+        return {k, INPUTS};
+    }
+};
+
+struct CandidatePassersExtractor: IFeatureExtractor {
+    int inputs() const override { return CandidatePassers::INPUTS; }
+    int max_active_features() const override { return CandidatePassers::MAX_ACTIVE_FEATURES; }
+    std::pair<int, int> fill_features_sparse(const TrainingDataEntry& e,
+                                             int*                     features,
+                                             float*                   values,
+                                             Color                    color) const override {
+        return CandidatePassers::fill_features_sparse(e, features, values, color);
+    }
+};
+
+struct PassedPawnsExtractor: IFeatureExtractor {
+    int inputs() const override { return PassedPawns::INPUTS; }
+    int max_active_features() const override { return PassedPawns::MAX_ACTIVE_FEATURES; }
+    std::pair<int, int> fill_features_sparse(const TrainingDataEntry& e,
+                                             int*                     features,
+                                             float*                   values,
+                                             Color                    color) const override {
+        return PassedPawns::fill_features_sparse(e, features, values, color);
+    }
+};
+
 struct ComposedFeatureExtractor: IFeatureExtractor {
     std::vector<std::unique_ptr<IFeatureExtractor>> extractors;
     int                                             m_inputs;
@@ -362,6 +645,12 @@ static std::unique_ptr<IFeatureExtractor> make_single_extractor(std::string_view
